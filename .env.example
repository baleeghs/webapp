# Copy to .env (`make setup` does) and adjust. The server reads .env in development; production
# sets real environment variables. Every APP_* variable maps to a field of
# server/crates/app-common/src/config.rs: nested fields use `__`.

# development | production | test
APP_ENV=development

# Postgres. Leave DATABASE_URL unset to run with in-memory storage (no setup; data is lost on
# restart; not allowed in production). To use Postgres: `make db-up`, then uncomment this line.
# DATABASE_URL is also what sqlx-cli uses.
# DATABASE_URL=postgres://app:app@localhost:5432/app
APP_DATABASE__MAX_CONNECTIONS=10
APP_DATABASE__RUN_MIGRATIONS=true

# HTTP
APP_HTTP__HOST=0.0.0.0
APP_HTTP__PORT=8080
# JSON array. Not needed in development: Vite proxies /api, so the browser sees one origin.
# APP_HTTP__CORS_ORIGINS=["https://app.example.com"]
# The built web app (`make build-web` writes it to server/static) is served at / by default,
# relative to the server's working directory. Set another folder, or empty to serve the API only.
# APP_HTTP__STATIC_DIR=static

# gRPC (50051 is the usual gRPC port, but tools such as Multipass claim it on many machines)
APP_GRPC__ENABLED=true
APP_GRPC__PORT=50052
APP_GRPC__REFLECTION=true

# In-process cache
APP_CACHE__TTL_SECS=60

# Logging: RUST_LOG overrides the filter. Format: pretty | json
APP_LOG__FILTER=info,sqlx=warn
APP_LOG__FORMAT=pretty
